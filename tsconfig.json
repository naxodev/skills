{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["scripts/**/*.ts", "skills/*/scripts/*.mjs", "eslint.config.mjs"],
  "exclude": ["**/node_modules"]
}
